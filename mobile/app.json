{
  "expo": {
    "name": "Style In Need Fashions",
    "slug": "styleinneed-fashions",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "styleinneed",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#FFF9F5",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.styleinneed.fashions",
      "config": {
        "googleMapsApiKey": "AIzaSyAPCeL0RU1lXB99o1mUwtfsxUB8WBb1-Tw"
      }
    },
    "android": {
      "package": "com.styleinneed.fashions",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF9F5"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAPCeL0RU1lXB99o1mUwtfsxUB8WBb1-Tw"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Style In Need uses your location to set your delivery address."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#C8A97E",
          "mode": "production"
        }
      ],
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://styleinneed-collections-64307221061.asia-south1.run.app/api/v1",
      "router": {},
      "eas": {
        "projectId": "88e38084-a68a-4447-a118-96308b3595b6"
      }
    }
  }
}
